PORT=3000

# --- Supabase (ÚNICA credencial realmente obligatoria) --------------------
# Proyecto PROPIO de Aura Studio (no el de Raabta ni el de Cieza Barber).
# Se usa la service role key porque el bot escribe citas/clientes desde el
# backend, sin pasar por RLS de usuario final. Sin esto el servicio no
# arranca — todo lo demás en este archivo es opcional.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp Cloud API (Meta) — OPCIONAL --------------------------------
# Mientras no estén las 4, el bot arranca igual y /public/disponibilidad +
# /public/reservas (reserva desde la web) funcionan normalmente; solo se
# apaga el canal de WhatsApp. Cargar las 4 y reiniciar el servicio en
# Railway lo activa, sin volver a desplegar código.
#
# Número DEDICADO de Aura Studio. No reutilizar el de Raabta ni el de Cieza
# Barber: un mismo phone_number_id no puede servir a dos negocios.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# OPCIONAL — sin esto, la IA que atiende WhatsApp no funciona, pero la
# reserva web sí (no la usa).
ANTHROPIC_API_KEY=

# --- Google Calendar — OPCIONAL -------------------------------------------
# Sin esto, las citas se crean igual en Supabase; simplemente no aparecen
# también en Calendar. Cuenta de servicio + calendario compartido con ella
# como "editor".
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# URL pública del bot: Google la necesita para el push de Calendar y el modal
# de la web la usa como BOT_API_URL.
PUBLIC_BASE_URL=https://bot.aurastudio.pe
GOOGLE_CALENDAR_WEBHOOK_TOKEN=

BUSINESS_TIMEZONE=America/Lima
# Teléfono al que el bot escala cuando no puede resolver solo.
ESCALATION_PHONE=51934641018
SITE_CATALOG_URL=https://aurastudio.pe

# --- Límites de gasto ----------------------------------------------------
RATE_LIMIT_MAX_PER_MINUTE=20
DAILY_TOKEN_BUDGET=500000

# --- CORS ----------------------------------------------------------------
# Orígenes autorizados a llamar a /admin/* y /public/*.
ADMIN_ORIGINS=https://admin.aurastudio.pe,http://localhost:5173
WEB_ORIGINS=https://aurastudio.pe,https://www.aurastudio.pe,http://localhost:4321

# --- Notificaciones ------------------------------------------------------
# Nombre exacto de la plantilla aprobada en el Administrador de WhatsApp,
# con 3 variables ({{1}} nombre, {{2}} servicio, {{3}} fecha y hora).
WHATSAPP_TEMPLATE_RECORDATORIO=recordatorio_cita
WHATSAPP_TEMPLATE_LANG=es
RECORDATORIO_HORAS_ANTES=1

LOG_LEVEL=info
